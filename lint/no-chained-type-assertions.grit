engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*\.(?:ts|tsx|mts|cts)$",
  $body <: contains bubble {
    or {
      TsAsExpression(),
      TsTypeAssertionExpression()
    } as $outer_assertion where {
      $outer_assertion <: or {
        `$value as $inner_type as $outer_type`,
        `($value as $inner_type) as $outer_type`,
        `<$outer_type><$inner_type>$value`,
        `<$outer_type>($value as $inner_type)`,
        r"(?s)^\s*\({2,}\s*[^()]+\s+as\s+[^()]+\s*\){2,}\s+as\s+.+$",
        r"(?s)^\s*<[^>]+>\s*\({2,}\s*<[^>]+>[^()]+\){2,}\s*$"
      },
      register_diagnostic(span=$outer_assertion, message="[anti-slop/no-chained-type-assertions] Preserve the value's type evidence instead of chaining type assertions.", severity="error")
    }
  }
}
