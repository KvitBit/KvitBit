engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*\.(?:ts|tsx|mts|cts)$",
  $body <: r"(?s).*\.\.\..*",
  $body <: contains bubble {
    or {
      `...($condition ? {} : $value)` as $conditional_spread,
      `...($condition ? $value : {})` as $conditional_spread
    } where {
      register_diagnostic(span=$conditional_spread, message="[anti-slop/no-conditional-empty-object-spread] Use a direct property or build the object in separate statements.", severity="error")
    }
  }
}
