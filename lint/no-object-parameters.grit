engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*\.(?:ts|tsx|mts|cts)$",
  $body <: r"(?s).*\bobject\b.*",
  $body <: contains bubble {
    or {
      JsFormalParameter() as $object_parameter,
      JsRestParameter() as $object_parameter
    } where {
      $object_parameter <: r"(?s)^.*:\s*object(?:\s*=.*)?$",
      register_diagnostic(span=$object_parameter, message="[anti-slop/no-object-parameters] Use the expected owner type instead of the broad object type.", severity="error")
    }
  }
}
