engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $body <: contains bubble {
    or {
      JsStaticMemberExpression(object=$process, member=`env`) as $access,
      JsComputedMemberExpression(object=$process, member=$key) as $access where {
        $key <: r"^[\x22']env[\x22']$"
      }
    } where {
      $process <: or {
        `process`,
        `globalThis.process`
      },
      register_diagnostic(span=$access, message="[no-direct-process-env] Read configuration through Effect Config.", severity="error")
    }
  }
}
