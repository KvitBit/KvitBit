engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*\.(?:ts|tsx|mts|cts)$",
  $body <: r"(?s).*\btypeof\b.*",
  $body <: contains bubble {
    JsUnaryExpression() as $runtime_typeof where {
      $runtime_typeof <: r"^typeof\b.*",
      register_diagnostic(span=$runtime_typeof, message="[anti-slop/no-runtime-typeof] Parse external input at its I/O boundary instead of narrowing it with typeof.", severity="error")
    }
  }
}
