engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*\.(?:ts|tsx|mts|cts)$",
  $body <: r"(?s).*\bvoid\b.*",
  $body <: contains bubble {
    `$condition ? $effect : Effect.void` as $conditional where {
      register_diagnostic(span=$conditional, message="[prefer-effect-when] Use Effect.when, Option, or Match instead of a ternary whose fallback is Effect.void.", severity="error")
    }
  }
}
