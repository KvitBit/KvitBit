[Unit]
Description=Assign Kvitbit visual feedback issues to T3 workers

[Service]
Type=oneshot
WorkingDirectory=%h/.t3/projects/invoicarr
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=kvitbit-issue-pool
UMask=0077
ExecStart=/usr/bin/flock -n %S/kvitbit-issue-pool/pass.lock %h/.bun/bin/bun scripts/issue-pool/service.ts --apply --state %S/kvitbit-issue-pool/pool.sqlite --project %h/.t3/projects/invoicarr
TimeoutStartSec=10min
