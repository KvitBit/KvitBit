{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/drizzle/meta", "!assets", "!**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": [
    {
      "path": "./lint/no-chained-type-assertions.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-conditional-empty-object-spread.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-known-value-widening.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-object-parameters.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-repeated-computed-conditional-operand.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-runtime-typeof.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-unknown-parameters.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-unknown-type-aliases.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-unsafe-dictionary-type.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-useless-alias.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-widen-then-assert.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-synchronous-subprocess.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/generated/**"]
    },
    {
      "path": "./lint/no-bare-promises.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
      ]
    },
    {
      "path": "./lint/no-direct-effect-runs.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!apps/server/src/{main,migrate,worker}.ts",
        "!apps/web/src/entry.ts",
        "!apps/mobile/src/runtime/request-intent.ts"
      ]
    },
    {
      "path": "./lint/no-direct-process-env.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!apps/mobile/src/config/env.ts"
      ]
    },
    {
      "path": "./lint/no-throw-in-effect-modules.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!packages/brand/src/{mark,pattern,svg}.ts"
      ]
    },
    {
      "path": "./lint/no-try-catch.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
      ]
    },
    {
      "path": "./lint/prefer-effect-fn.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "scripts/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
      ]
    },
    {
      "path": "./lint/prefer-effect-value.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "scripts/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
      ]
    },
    {
      "path": "./lint/prefer-effect-when.grit",
      "resolutionKind": "config",
      "includes": [
        "{apps,packages,infra}/*/src/**",
        "apps/mobile/app/**",
        "src/**",
        "scripts/**",
        "!**/{test,tests,testing,__tests__,__fixtures__,generated}/**",
        "!**/*.{test,spec,test-utils}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
      ]
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "test"
          }
        },
        "noContinue": "off",
        "noDefaultExport": "off",
        "noExcessiveClassesPerFile": "off",
        "noExcessiveLinesPerFile": "off",
        "noHexColors": "off",
        "noImplicitBoolean": "off",
        "noIncrementDecrement": "off",
        "noJsxLiterals": "off",
        "noMagicNumbers": "off",
        "noNegationElse": "off",
        "noNestedTernary": "off",
        "noTernary": "off",
        "useBlockStatements": "off",
        "useConsistentArrayType": "off",
        "useDefaultSwitchClause": "off",
        "useDestructuring": "off",
        "useExportsLast": "off",
        "useFilenamingConvention": "off",
        "useNamedCaptureGroup": "off",
        "useNamingConvention": "off",
        "useNumericSeparators": "off",
        "useUnicodeRegex": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noBitwiseOperators": "off"
      },
      "nursery": {
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeAssertion": "error",
        "noMisusedPromises": "error",
        "noUnsafeReturn": "error",
        "noUnsafePlusOperands": "error",
        "useStrictBooleanExpressions": "error",
        "noFloatingPromises": "error",
        "noUnsafeUnaryMinus": "error",
        "noMisusedSpread": "error",
        "noUselessAwait": "error",
        "usePromiseRejectErrors": "error",
        "noJsonUnsafeValues": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "noExcessiveNestedCallbacks": "off",
        "useMaxParams": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "noBarrelFile": "off",
        "noReExportAll": "off"
      },
      "correctness": {
        "useImportExtensions": "off"
      }
    },
    "domains": {
      "types": "all",
      "project": "all",
      "drizzle": "all",
      "test": "all",
      "turborepo": "all",
      "playwright": "none",
      "react": "none",
      "reactNative": "none",
      "qwik": "none",
      "solid": "none"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/e2e/**"],
      "linter": {
        "domains": {
          "playwright": "all"
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "domains": {
          "react": "all",
          "reactNative": "all"
        }
      },
      "javascript": {
        "globals": ["Bun", "__DEV__"]
      }
    },
    {
      "includes": [
        "apps/server/**",
        "apps/mobile/app.config.ts",
        "apps/mobile/plugins/**",
        "apps/mobile/scripts/**",
        "apps/mobile/release/**",
        "apps/web/e2e/**",
        "apps/web/*.config.*",
        "infra/alchemy/**",
        "packages/adapters/**",
        "packages/db/**",
        "**/test/**",
        "formal/**",
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/config/env.ts"],
      "linter": {
        "rules": { "correctness": { "noProcessGlobal": "off" }, "style": { "noProcessEnv": "off" } }
      }
    }
  ],
  "javascript": {
    "globals": ["Bun"]
  }
}
