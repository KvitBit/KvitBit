      "env": ["TZ"],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "test:mail": {
      "dependsOn": [],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "src/config.ts",
        "src/deploy-preflight.ts",
        "src/env.ts",
        "src/mail-forwarder/**",
        "src/resources/mail.ts",
        "src/resources/network.ts",
        "test/mail-forwarder.test.ts"
      ],
      "env": ["TZ"],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "test:infra": {
      "dependsOn": [],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "src/**",
        "test/bootstrap-stage.test.ts",
        "test/monitoring-provider.test.ts",
        "test/turbo-cache.test.ts"
      ],
      "env": ["TZ"],
      "passThroughEnv": ["CI"],
      "outputs": []
    }
  }
