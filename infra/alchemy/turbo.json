{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:suite": {
      "dependsOn": ["test:selfhost", "test:stack", "test:mail", "test:infra"],
      "cache": false
    },
    "test:selfhost": {
      "dependsOn": [],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "src/deploy-preflight.ts",
        "src/preflight-cli.ts",
        "test/selfhost.test.ts",
        "$TURBO_ROOT$/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/docker-compose.yml",
        "$TURBO_ROOT$/docker/**",
        "$TURBO_ROOT$/flake.nix",
        "$TURBO_ROOT$/bun.nix",
        "$TURBO_ROOT$/.github/workflows/deploy.yml",
        "$TURBO_ROOT$/packages/db/drizzle/20261123175822_init/migration.sql"
      ],
      "env": ["TZ"],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "test:stack": {
      "dependsOn": [],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "alchemy.run.ts",
        "src/**",
        "test/stack.test.ts",
        "$TURBO_ROOT$/.github/workflows/deploy.yml"
