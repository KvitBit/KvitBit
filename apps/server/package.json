{
  "name": "@kvitbit/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "migrate": "bun src/migrate.ts",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "effect-tsgo tsc -p tsconfig.json",
    "test": "bun test --pass-with-no-tests",
