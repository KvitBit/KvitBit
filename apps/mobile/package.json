{
  "name": "@kvitbit/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    "./release/*": "./release/*.ts"
  },
  "scripts": {
    "start": "expo start",
    "build": "bun run build:pwa",
    "build:pwa": "bun scripts/build-pwa.ts",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "release:apk": "bun ../../scripts/release/mobile-release.ts build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@kvitbit/api-contract": "workspace:*",
    "@kvitbit/brand": "workspace:*",
    "@kvitbit/domain": "workspace:*",
    "@kvitbit/ui-port": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "effect": "4.1.4",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-passkeys": "0.4.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
