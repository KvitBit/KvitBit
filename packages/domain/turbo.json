{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:suite": {
      "dependsOn": ["test:money", "test:unit"],
      "cache": false
    },
    "test:money": {
      "dependsOn": ["^transit"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "src/money.ts",
        "src/vocabulary.ts",
        "test/money.test.ts",
        "test/money.property.test.ts"
      ],
      "env": ["TZ"],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "src/**",
        "test/**",
        "!test/money.test.ts",
        "!test/money.property.test.ts"
      ],
      "env": ["TZ"],
      "passThroughEnv": ["CI"],
      "outputs": []
    }
  }
}
