{
  "name": "@kvitbit/ui-port",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./style": "./src/style/index.ts",
