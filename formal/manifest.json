          "description": "as skip-occurrence, liveness only: EveryOccurrenceIssued breaks"
        },
        {
          "name": "claim-fails",
          "config": "formal/outbox/OutboxRecurring_mutant_claim_fails.cfg",
          "expect": "violation",
          "violates": {
            "kind": "invariant",
            "name": "FailedOnlyAfterCall"
          },
          "description": "claim marks a queued delivery failed without a provider call (NoLostSend alone would pass)"
