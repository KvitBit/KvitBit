          "expect": "violation",
          "violates": {
            "kind": "temporal"
          },
          "description": "issue re-issues instead of returning the issued run: the rerun after a crash between issue and send is Skipped, NoLostSend breaks"
        },
        {
          "name": "start-before-commit",
          "config": "formal/outbox/OutboxRecurring_mutant_start_before_commit.cfg",
          "expect": "violation",
          "violates": {
            "kind": "invariant",
            "name": "StartedOnlyCommitted"
          },
          "description": "DeliveryJobs.start inside the send transaction: a rolled-back delivery gets a workflow"
        },
        {
          "name": "no-reconcile-h3",
          "config": "formal/outbox/OutboxRecurring_mutant_no_reconcile_h3.cfg",
          "expect": "violation",
          "violates": {
            "kind": "temporal"
          },
          "deadlock": "allow",
          "description": "H3 on the code at 77a5bb7 (no J1a delivery reconcile in core): a crash between claim and the provider call leaves the delivery sending forever, NoLostSend breaks"
        },
        {
          "name": "no-reconcile-lost-start",
          "config": "formal/outbox/OutboxRecurring_mutant_no_reconcile_lost_start.cfg",
          "expect": "violation",
          "violates": {
            "kind": "temporal"
          },
          "deadlock": "allow",
          "description": "The code at 77a5bb7 (no J1a delivery reconcile): a crash before the afterCommit start leaves the delivery queued forever, NoLostSend breaks"
        },
        {
          "name": "no-send-replay-guard",
          "config": "formal/outbox/OutboxRecurring_mutant_no_send_replay_guard.cfg",
          "expect": "violation",
          "violates": {
            "kind": "invariant",
            "name": "OneDeliveryPerOccurrence"
          },
          "description": "send sends again for an already queued run (issuance.ts:326-332, the queued replay and the pending-only check, dropped): two deliveries"
        },
        {
          "name": "skip-occurrence",
          "config": "formal/outbox/OutboxRecurring_mutant_skip_occurrence.cfg",
          "expect": "violation",
          "violates": {
            "kind": "invariant",
            "name": "NextFollowsIssued"
          },
          "description": "next_occurrence advances two occurrences per issue: one is never issued"
        },
        {
          "name": "skip-occurrence-liveness",
          "config": "formal/outbox/OutboxRecurring_mutant_skip_occurrence_liveness.cfg",
          "expect": "violation",
          "violates": {
            "kind": "temporal"
          },
