{
  "name": "kvitbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck && bun run typecheck:formal",
    "typecheck:formal": "tsc -p formal/tsconfig.json",
    "verify:formal": "bun formal/run-formal.ts",
    "test": "turbo run test",
    "test:static-mounts": "bun test ./apps/server/test/integration/static-mounts.integration.ts",
    "build": "turbo run build",
    "generate:bun-nix": "bun scripts/generate-bun-nix.ts",
    "db:generate": "turbo run db:generate --filter=@kvitbit/db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "effect": "4.1.4",
    "turbo": "2.11.13",
    "typescript": "6.0.2"
  },
  "overrides": {
    "effect": "4.1.4"
  },
  "packageManager": "bun@1.4.2"
}
