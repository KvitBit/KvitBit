{
  "name": "kvitbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck && bun run typecheck:scripts && bun run typecheck:formal",
    "typecheck:formal": "effect-tsgo tsc -p formal/tsconfig.json",
    "verify:formal": "bun formal/run-formal.ts",
    "test": "turbo run test",
    "test:static-mounts": "bun test ./apps/server/test/integration/static-mounts.integration.ts",
    "build": "turbo run build",
    "generate:bun-nix": "bun scripts/generate-bun-nix.ts",
    "db:generate": "turbo run db:generate --filter=@kvitbit/db",
    "typecheck:scripts": "effect-tsgo tsc -p scripts/tsconfig.json",
    "check:changed": "bun scripts/check-changed.ts",
    "knip:check:files": "bun --bun knip --files --dependencies",
    "knip:check:exports": "bun --bun knip --exports",
    "knip:check": "bun run --parallel --no-exit-on-error knip:check:files knip:check:exports",
    "prepare": "if command -v git >/dev/null && git rev-parse --is-inside-work-tree >/dev/null 2>&1 && test -f .githooks/pre-commit; then git config --local extensions.worktreeConfig true && git config --worktree core.hooksPath .githooks; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@effect/language-service": "0.87.5",
    "@effect/platform-bun": "4.1.4",
    "@effect/tsgo": "0.73.7",
    "@types/bun": "1.4.5",
    "effect": "4.1.4",
    "knip": "6.48.0",
    "turbo": "2.11.13",
    "typescript": "6.0.2"
  },
  "overrides": {
    "effect": "4.1.4"
  },
  "packageManager": "bun@1.4.2"
}
